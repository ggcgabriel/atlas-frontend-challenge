# Copy to .env and adjust. The compose file and the Nuxt server both read these.

# --- Postgres (docker-compose) ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas_catalog
# Host port. 5433 avoids clashing with a Postgres already running on 5432.
POSTGRES_PORT=5433

# --- Application ---
# Read by Nuxt as runtimeConfig.databaseUrl (server-side only).
NUXT_DATABASE_URL=postgresql://atlas:atlas@localhost:5433/atlas_catalog
# drizzle-kit reads this one directly (it runs outside Nuxt).
DATABASE_URL=postgresql://atlas:atlas@localhost:5433/atlas_catalog
